# Qwen Cloud
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Wan / HappyHorse Video Generation
WAN_API_KEY=your_wan_api_key
WAN_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autodirector
POSTGRES_USER=autodirector
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0

# YouTube
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secrets.json
YOUTUBE_CHANNEL_ID=your_channel_id

# Pipeline config
AUTO_APPROVE=false
MANIM_WORKERS=4
MANIM_QUALITY=h
LOG_LEVEL=INFO

# Memgraph Knowledge Graph
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
MEMGRAPH_ENABLED=false

# Source Ingestion
MAX_PDF_SIZE_MB=50
PLAYWRIGHT_ENABLED=true
EMBEDDING_BATCH_SIZE=32

# ── Backblaze B2 ──────────────────────────────────────────────
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=quantifaya
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_PUBLIC_URL_BASE=https://f005.backblazeb2.com/file/quantifaya
# Note: get your exact key ID + application key from B2 dashboard.
# Friendly URL: https://f005.backblazeb2.com/file/{bucket_name}
